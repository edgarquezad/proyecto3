<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>
<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="fondo-principal" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.egibide.proyecto3.Controladores.VentanaPrincipalController">

    <stylesheets>
        <URL value="@Estilos.css"/>
    </stylesheets>

    <left>
        <VBox prefWidth="220.0" spacing="12.0" styleClass="menu-lateral" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="25" left="18" right="18" top="30"/>
            </padding>

            <Label styleClass="titulo-principal" text="GESTIÓN"/>

            <Label styleClass="subtitulo" text="SISTEMA DE CONTROL"/>

            <Region prefHeight="20"/>

            <Button fx:id="btnInicio" maxWidth="Infinity" onAction="#mostrarInicio" styleClass="menu-button"
                    text="Inicio">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Button>

            <Button fx:id="btnProveedores" maxWidth="Infinity"
                    onAction="#mostrarProveedores"
                    styleClass="menu-button"
                    text="Proveedores">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Button>

            <Button fx:id="btnPiezas" maxWidth="Infinity"
                    onAction="#mostrarVistaPieza" styleClass="menu-button"
                    text="Piezas">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Button>

            <Button fx:id="btnProyectos" maxWidth="Infinity"
                    styleClass="menu-button" text="Proyectos">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Button>

        </VBox>
    </left>
    <center>
        <VBox fx:id="contenedorContenido"
                spacing="10"
              style="-fx-padding: 20;">

            <Label fx:id="lblTitulo"
                   text="¡Bienvenido!"
                   styleClass="label-TituloP"
            />

            <Label fx:id="lblDescripcion"
                   text="Selecciona un apartado para comenzar a gestionar los datos."
                   styleClass="label-descripcion"/>


        </VBox>


    </center>

</BorderPane>
