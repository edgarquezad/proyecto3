<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="formulario" alignment="CENTER" prefHeight="400.0"
      prefWidth="600.0" spacing="15"
      style="-fx-padding: 25;"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="org.egibide.proyecto3.Controladores.FormularioPiezas">

    <Label text="Datos de la pieza">
      <font>
         <Font name="System Bold" size="12.0" />
      </font>
    </Label>

    <TextField fx:id="txtCodigo" promptText="Código" />
    <TextField fx:id="txtNombre" promptText="Nombre" />
    <TextField fx:id="txtPrecio" promptText="Precio" />
    <TextArea fx:id="txtDescripcio" promptText="Descripción" />

    <HBox alignment="CENTER" spacing="10">
        <Button text="Cancelar" onAction="#cancelar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>

        </Button>
        <Button fx:id="btnGuardar"
                onAction="#guardar" text="Guardar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
        </Button>


    </HBox>

</VBox>
